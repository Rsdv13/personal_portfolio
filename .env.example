# Copy to .env for local development (gitignored). On Render, set these as real
# environment variables in the service's dashboard instead of committing a .env file.
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini

# Postgres connection string (e.g. from Supabase: Project Settings -> Database ->
# Connection string -> URI, using the "Transaction" pooler on port 6543). Enables
# traffic logging and chat lead-capture. Leave unset to run with both disabled.
DATABASE_URL=postgresql://postgres:password@host:6543/postgres

# Basic-auth password for /admin/stats. Leave unset to keep that page inaccessible.
ADMIN_PASSWORD=choose-a-real-password

# Salt mixed into visitor IP hashes before storing them (so hashes aren't a plain
# lookup table). Any random string; changing it just makes old and new hashes for
# the same visitor look different, which is harmless.
IP_HASH_SALT=change-me-to-any-random-string
